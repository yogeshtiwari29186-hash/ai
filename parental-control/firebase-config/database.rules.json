{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "families": {
      "$parentUid": {
        ".read": "auth != null && auth.uid === $parentUid",
        ".write": "auth != null && auth.uid === $parentUid",
        "children": {
          "$childUid": {
            ".read": "auth != null && (auth.uid === $parentUid || auth.uid === $childUid)"
          }
        }
      }
    },
    "pairingCodes": {
      ".read": false,
      ".write": false
    }
  }
}
